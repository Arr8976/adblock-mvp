{
  "manifest_version": 3,
  "name": "Adblock MVP (YouTube + CHZZK)",
  "version": "0.3.3",
  "description": "v0.3.3: content-shape rewrite + Uint8Array hook (no blind /gfp short-circuit). Not affiliated with Malwarebytes.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "webNavigation",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://*.googlevideo.com/*",
    "*://*.doubleclick.net/*",
    "*://*.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.chzzk.naver.com/*",
    "*://chzzk.naver.com/*",
    "*://*.naver.com/*",
    "*://*.ad.naver.com/*",
    "*://*.ads.naver.com/*",
    "*://*.veta.naver.com/*",
    "*://*.pstatic.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Adblock MVP 0.3.3",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_static",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["content/shared.js", "content/youtube.js"],
      "css": ["content/hide.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://chzzk.naver.com/*", "*://*.chzzk.naver.com/*"],
      "js": ["content/chzzk-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://chzzk.naver.com/*", "*://*.chzzk.naver.com/*"],
      "js": ["content/shared.js", "content/chzzk.js"],
      "css": ["content/hide.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/chzzk-inject.js"],
      "matches": ["*://chzzk.naver.com/*", "*://*.chzzk.naver.com/*"]
    }
  ]
}
